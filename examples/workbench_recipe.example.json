{
  "version": "1",
  "workdir": "..",
  "variables": {
    "length_mm": 100,
    "width_mm": 20,
    "height_mm": 10
  },
  "steps": [
    {
      "id": "parameters",
      "type": "file",
      "action": "write_text",
      "path": ".ansys_mcp/spaceclaim-example/parameters.json",
      "content": "{\"length_mm\": ${length_mm}, \"width_mm\": ${width_mm}, \"height_mm\": ${height_mm}}"
    },
    {
      "id": "geometry",
      "type": "workbench",
      "mode": "batch",
      "recipe": {
        "project": {
          "save_path": ".ansys_mcp/spaceclaim-example/model.wbpj"
        },
        "actions": [
          {
            "op": "get_template",
            "template_name": "Geometry",
            "store_as": "template"
          },
          {
            "op": "create_system",
            "template": "template",
            "store_as": "system"
          },
          {
            "op": "get_container",
            "target": "system",
            "component_name": "Geometry",
            "store_as": "geometry"
          },
          {
            "op": "call",
            "target": "geometry",
            "method": "Edit",
            "kwargs": {
              "IsSpaceClaimGeometry": true,
              "Interactive": false
            }
          },
          {
            "op": "run_script",
            "target": "geometry",
            "script_path": "examples/scripts/spaceclaim_geometry.py"
          },
          {
            "op": "call",
            "target": "geometry",
            "method": "Exit"
          },
          {
            "op": "get_attr",
            "target": "system",
            "attribute": "Name",
            "store_as": "system_name"
          }
        ]
      },
      "produces": [
        {
          "path": ".ansys_mcp/spaceclaim-example/model.wbpj"
        },
        {
          "path": ".ansys_mcp/spaceclaim-example/channel.scdocx"
        },
        {
          "path": ".ansys_mcp/spaceclaim-example/channel.step"
        },
        {
          "path": ".ansys_mcp/spaceclaim-example/measurements.json"
        }
      ]
    },
    {
      "id": "measurements",
      "type": "file",
      "action": "read_text",
      "path": ".ansys_mcp/spaceclaim-example/measurements.json"
    }
  ]
}
